<%- include('../partials/layout_top', {title: title}) %>
<div class="page-title">
  <div>
    <h1><i class="bi bi-archive"></i> مخزن اسناد</h1>
    <div class="subtitle"><%= canManage ? 'همه اسناد (دسترسی مدیریتی)' : 'اسناد و فرم‌های عمومی سازمان' %></div>
  </div>
  <div class="d-flex gap-2">
    <form class="d-flex gap-2" method="get" action="/docs">
      <input type="text" class="form-control form-control-sm" name="q" placeholder="جستجوی سند..." value="<%= q %>">
      <button class="btn btn-sm btn-outline-secondary">جستجو</button>
    </form>
    <% if (canManage) { %><a class="btn btn-primary btn-sm" href="/documents"><i class="bi bi-gear me-1"></i> مدیریت اسناد</a><% } %>
  </div>
</div>
<div class="card">
  <div class="card-body p-0">
    <% if (!rows.length) { %><div class="empty-state"><i class="bi bi-archive"></i>سندی یافت نشد.</div>
    <% } else { %><div class="table-wrap p-3"><table class="table table-hover align-middle" data-sortable>
      <thead><tr><th>عنوان</th><th>دسته</th><th>نسخه</th><th>تاریخ بازنگری</th><th>سطح</th><th>دانلود</th></tr></thead>
      <tbody>
        <% rows.forEach(function(d){ %>
          <tr>
            <td><b><%= d.title %></b></td>
            <td><%= U.label(d.category) %></td>
            <td dir="ltr"><%= d.version || '—' %></td>
            <td><%= U.jDate(d.expiry_date) %></td>
            <td><span class="badge bg-<%= d.visibility==='hr'?'danger':'success' %>"><%= d.visibility==='hr' ? 'فقط HR' : 'عمومی' %></span></td>
            <td>
              <a href="/files/doc/<%= d.id %>" class="btn btn-sm btn-outline-primary btn-icon" title="دانلود"><i class="bi bi-download"></i></a>
              <% if (canManage) { %><a href="/documents/<%= d.id %>/edit" class="btn btn-sm btn-outline-secondary btn-icon"><i class="bi bi-pencil"></i></a><% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table></div><% } %>
  </div>
</div>
<%- include('../partials/layout_bottom') %>
