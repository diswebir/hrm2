<%- include('../partials/layout_top', {title: title}) %>
<div class="page-title">
  <div>
    <h1><i class="bi bi-megaphone"></i> اطلاعیه‌ها</h1>
  </div>
  <% if (HH.can(user, 'announcements')) { %><a class="btn btn-primary btn-sm" href="/announcements"><i class="bi bi-gear me-1"></i> مدیریت اطلاعیه‌ها</a><% } %>
</div>
<% if (!rows.length) { %><div class="card"><div class="empty-state"><i class="bi bi-megaphone"></i>اطلاعیه‌ای برای شما منتشر نشده است.</div></div>
<% } else { %>
<% rows.forEach(function(a){ %>
  <div class="card mb-3 <%= a.pinned ? 'border-warning' : '' %>">
    <div class="card-body">
      <div class="d-flex justify-content-between flex-wrap gap-2">
        <h5 class="mb-1" style="font-weight:800"><%= a.pinned ? '📌 ' : '' %><%= a.title %></h5>
        <small class="text-muted2"><%= a.dept_name ? 'ویژه ' + a.dept_name : 'عمومی' %> — <%= U.jDate((a.publish_date || '').slice(0,10)) %></small>
      </div>
      <p class="mb-2" style="white-space:pre-wrap;font-size:13.5px"><%= String(a.body || '').slice(0, 300) %><%= String(a.body||'').length > 300 ? '...' : '' %></p>
      <a href="/announcements/view/<%= a.id %>" class="btn btn-sm btn-outline-primary">ادامه مطلب</a>
    </div>
  </div>
<% }) %>
<% } %>
<%- include('../partials/layout_bottom') %>
