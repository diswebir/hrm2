<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>فیش حقوقی — <%= row.first_name %> <%= row.last_name %></title>
  <link rel="stylesheet" href="/vendor/bootstrap.rtl.min.css">
  <link rel="stylesheet" href="/vendor/fonts-vazirmatn/vazirmatn.css">
  <style>
    body{font-family:'Vazirmatn',Tahoma;font-size:13px;background:#f4f5fb}
    .slip{max-width:760px;margin:24px auto;background:#fff;border-radius:12px;padding:26px;border:1px solid #e3e5ef}
    .head{display:flex;justify-content:space-between;align-items:center;border-bottom:3px double #312e81;padding-bottom:12px;margin-bottom:16px}
    .head h2{font-size:17px;font-weight:900;margin:0;color:#312e81}
    .mtable{width:100%;border-collapse:collapse;margin-bottom:14px}
    .mtable th,.mtable td{border:1px solid #d7d9e6;padding:6px 10px;font-size:12.5px}
    .mtable th{background:#eef0fa;width:22%}
    .calc{width:100%;border-collapse:collapse}
    .calc td{padding:7px 10px;border-bottom:1px dashed #d7d9e6;font-size:13px}
    .calc td:last-child{text-align:left;direction:ltr;font-weight:700}
    .net{background:#e8f8ee;border:1px solid #16a34a;border-radius:10px;padding:12px 16px;display:flex;justify-content:space-between;align-items:center;margin-top:14px}
    .net b{font-size:20px;color:#16a34a}
    .sign{display:flex;justify-content:space-between;margin-top:34px;font-size:12px;color:#555}
    @media print{body{background:#fff}.slip{border:none;margin:0}.noprint{display:none}}
  </style>
</head>
<body>
<div class="slip">
  <div class="head">
    <div>
      <h2><%= s.company_name %></h2>
      <div style="font-size:12px;color:#666">فیش حقوقی <%= monthLabel %></div>
    </div>
    <div style="text-align:left;font-size:11.5px;color:#888">
      <div>شماره ردیف: <%= row.id %></div>
      <div>وضعیت: <%= row.status === 'final' ? 'نهایی ✓' : 'پیش‌نویس' %></div>
    </div>
  </div>

  <table class="mtable">
    <tr>
      <th>نام و نام خانوادگی</th><td><%= row.first_name %> <%= row.last_name %></td>
      <th>شماره پرسنلی</th><td><%= row.code %></td>
    </tr>
    <tr>
      <th>سمت</th><td><%= row.desig_name || '—' %></td>
      <th>واحد</th><td><%= row.dept_name || '—' %></td>
    </tr>
    <tr>
      <th>کد ملی</th><td><%= row.national_id || '—' %></td>
      <th>روزهای کارکرد</th><td><%= row.worked_days %> روز</td>
    </tr>
    <tr>
      <th>بانک / حساب</th><td><%= row.bank_name || '—' %> <%= row.bank_account || '' %></td>
      <th>ساعت اضافه‌کاری</th><td><%= row.overtime_hours %> ساعت</td>
    </tr>
  </table>

  <table class="calc">
    <tr><td>حقوق پایه ماهانه</td><td><%= U.moneyPlain(row.base) %> <%= s.currency %></td></tr>
    <tr><td>اضافه‌کاری (<%= row.overtime_hours %> ساعت)</td><td><%= U.moneyPlain(row.overtime_amount) %></td></tr>
    <% JSON.parse(JSON.stringify(items)).filter(i=>i.kind==='allowance').forEach(function(i){ %>
      <tr><td><i class="bi bi-plus"></i> <%= i.label %></td><td><%= U.moneyPlain(i.amount) %></td></tr>
    <% }) %>
    <% if (row.allowances) { %><tr><td>جمع مزایا</td><td><%= U.moneyPlain(row.allowances) %></td></tr><% } %>
    <% if (row.insurance) { %><tr><td>بیمه سهم کارمند</td><td style="color:#dc2626">− <%= U.moneyPlain(row.insurance) %></td></tr><% } %>
    <% if (row.tax) { %><tr><td>مالیات</td><td style="color:#dc2626">− <%= U.moneyPlain(row.tax) %></td></tr><% } %>
    <% if (row.deductions) { %><tr><td>کسورات</td><td style="color:#dc2626">− <%= U.moneyPlain(row.deductions) %></td></tr><% } %>
    <% JSON.parse(JSON.stringify(items)).filter(i=>i.kind==='deduction').forEach(function(i){ %>
      <tr><td><i class="bi bi-dash"></i> <%= i.label %></td><td style="color:#dc2626">− <%= U.moneyPlain(i.amount) %></td></tr>
    <% }) %>
    <% if (row.loan_deduction) { %><tr><td>قسط وام / مساعده</td><td style="color:#dc2626">− <%= U.moneyPlain(row.loan_deduction) %></td></tr><% } %>
  </table>

  <div class="net">
    <span style="font-weight:800">خالص پرداختی:</span>
    <b><%= U.moneyPlain(row.net) %> <%= s.currency %></b>
  </div>

  <div class="sign">
    <span>امضای دریافت‌کننده: ..................</span>
    <span>مدیر منابع انسانی: ..................</span>
  </div>
</div>
<div class="text-center noprint mb-4">
  <button class="btn btn-primary px-4" onclick="window.print()">چاپ فیش</button>
  <a class="btn btn-outline-secondary" href="javascript:history.back()">بازگشت</a>
</div>
</body>
</html>
