<%- include('../partials/layout_top', {title: title}) %>
<div class="page-title">
  <div>
    <h1><i class="bi bi-wallet2"></i> فیش‌های حقوقی من</h1>
    <div class="subtitle">لیست‌های نهایی‌شده</div>
  </div>
</div>
<div class="card">
  <div class="card-body p-0">
    <% if (!rows.length) { %><div class="empty-state"><i class="bi bi-wallet2"></i>هنوز فیشی برای شما صادر نشده است.</div>
    <% } else { %><div class="table-wrap p-3"><table class="table table-hover align-middle" data-sortable>
      <thead><tr><th>ماه</th><th>پایه</th><th>اضافه‌کاری</th><th>مزایا</th><th>کسورات</th><th>بیمه</th><th>مالیات</th><th>وام</th><th>خالص</th><th>فیش</th></tr></thead>
      <tbody>
        <% rows.forEach(function(p){ %>
          <tr>
            <td><b><%= p.month.replace('-', '/') %></b></td>
            <td><%= U.moneyPlain(p.base) %></td>
            <td><%= U.moneyPlain(p.overtime_amount) %></td>
            <td><%= U.moneyPlain(p.allowances) %></td>
            <td><%= U.moneyPlain(p.deductions) %></td>
            <td><%= U.moneyPlain(p.insurance) %></td>
            <td><%= U.moneyPlain(p.tax) %></td>
            <td><%= p.loan_deduction ? U.moneyPlain(p.loan_deduction) : '—' %></td>
            <td><b class="text-success"><%= U.moneyPlain(p.net) %></b></td>
            <td><a href="/payroll/slip/<%= p.id %>" class="btn btn-sm btn-outline-primary btn-icon"><i class="bi bi-printer"></i></a></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div><% } %>
  </div>
</div>
<%- include('../partials/layout_bottom') %>
