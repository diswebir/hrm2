<%- include('../partials/layout_top', {title: title}) %>
<div class="page-title">
  <div>
    <h1><i class="bi bi-stopwatch"></i> اضافه‌کاری<%= mine ? ' — درخواست‌های من' : '' %></h1>
    <div class="subtitle">درخواست‌ها پس از تایید، در لیست حقوق محاسبه می‌شوند</div>
  </div>
  <% if (mine) { %><button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#otModal"><i class="bi bi-plus-lg me-1"></i> درخواست جدید</button><% } %>
</div>
<%- include('../partials/flash') %>
<div class="card">
  <div class="card-body p-0"><div class="table-wrap p-3">
    <table class="table table-hover align-middle" data-sortable>
      <thead><tr><th>کارمند</th><th>تاریخ</th><th>ساعت</th><th>دلیل</th><th>وضعیت</th><th>یادداشت تاییدکننده</th></tr></thead>
      <tbody>
        <% if (!rows.length) { %><tr><td colspan="6" class="text-center text-muted2 py-4">درخواستی وجود ندارد.</td></tr><% } %>
        <% rows.forEach(function(o){ %>
          <tr>
            <td><b><%= o.first_name %> <%= o.last_name %></b></td>
            <td><%= U.jDate(o.date) %></td>
            <td><%= U.faNum(o.hours) %> ساعت</td>
            <td style="font-size:12.5px"><%= o.reason || '—' %></td>
            <td><span class="badge bg-<%= HH.badgeClass(o.status) %>"><%= U.label(o.status) %></span></td>
            <td style="font-size:12.5px"><%= o.decision_note || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div></div>
</div>

<% if (mine) { %>
<div class="modal fade" id="otModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="post" action="/overtime">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="modal-header"><h5 class="modal-title">درخواست اضافه‌کاری</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
          <div class="mb-3"><label class="form-label req">تاریخ</label><input type="text" class="form-control jdate" name="date" required></div>
          <div class="mb-3"><label class="form-label req">تعداد ساعت</label><input type="number" class="form-control" name="hours" step="0.5" min="0.5" value="1" required></div>
          <div class="mb-3"><label class="form-label">دلیل</label><textarea class="form-control" name="reason" rows="2"></textarea></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">انصراف</button>
          <button class="btn btn-primary">ثبت درخواست</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>
<%- include('../partials/layout_bottom') %>
