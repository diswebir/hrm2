<%- include('../partials/layout_top', {title: title}) %>
<div class="page-title">
  <div>
    <h1><i class="bi bi-clipboard-data"></i> ارزیابی عملکرد</h1>
  </div>
  <div class="d-flex gap-2">
    <a class="btn btn-outline-secondary btn-sm" href="/appraisal-cycles"><i class="bi bi-calendar-range me-1"></i> دوره‌های ارزیابی</a>
    <a class="btn btn-outline-secondary btn-sm" href="/goals"><i class="bi bi-bullseye me-1"></i> اهداف (KPI)</a>
    <a class="btn btn-primary btn-sm" href="/appraisals/new"><i class="bi bi-plus-lg me-1"></i> ارزیابی جدید</a>
  </div>
</div>
<div class="row g-3">
  <div class="col-lg-8">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-list-check"></i> ارزیابی‌های ثبت‌شده</div>
      <div class="card-body p-0">
        <% if (!rows.length) { %><div class="empty-state"><i class="bi bi-clipboard-data"></i>ارزیابی‌ای ثبت نشده است.</div>
        <% } else { %><div class="table-wrap p-3"><table class="table table-hover align-middle" data-sortable>
          <thead><tr><th>کارمند</th><th>دوره</th><th>ارزیاب</th><th>امتیاز (از ۵)</th><th>تاریخ</th><th></th></tr></thead>
          <tbody>
            <% rows.forEach(function(a){ %>
              <tr>
                <td><b><%= a.first_name %> <%= a.last_name %></b></td>
                <td><%= a.cycle_title %></td>
                <td><%= a.reviewer || '—' %></td>
                <td>
                  <span class="badge <%= a.total >= 4 ? 'bg-success' : (a.total >= 3 ? 'bg-warning text-dark' : 'bg-danger') %>" style="font-size:13px"><%= U.faNum(a.total) %></span>
                </td>
                <td style="font-size:12px"><%= a.created_at ? U.jDate(a.created_at.slice(0,10)) : '—' %></td>
                <td class="text-nowrap">
                  <a class="btn btn-sm btn-outline-primary btn-icon" href="/appraisals/<%= a.id %>"><i class="bi bi-eye"></i></a>
                  <form class="d-inline" method="post" action="/appraisals/<%= a.id %>/delete" data-confirm="حذف شود؟">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <button class="btn btn-sm btn-outline-danger btn-icon"><i class="bi bi-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table></div><% } %>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-person"></i> ارزیابی‌های من</div>
      <div class="card-body p-0">
        <% if (!mine.length) { %><div class="empty-state" style="padding:18px">ارزیابی‌ای برای شما ثبت نشده است.</div>
        <% } else { %><ul class="list-group list-group-flush">
          <% mine.forEach(function(a){ %>
            <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent">
              <a href="/appraisals/<%= a.id %>"><%= a.cycle_title %></a>
              <span class="badge bg-primary"><%= U.faNum(a.total) %> / ۵</span>
            </li>
          <% }) %>
        </ul><% } %>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/layout_bottom') %>
