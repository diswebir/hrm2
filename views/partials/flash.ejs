<% if (q && q.saved) { %><div class="alert alert-success auto-hide"><i class="bi bi-check-circle me-1"></i> با موفقیت ذخیره شد.</div><% } %>
<% if (q && q.deleted) { %><div class="alert alert-info auto-hide"><i class="bi bi-trash me-1"></i> حذف انجام شد.</div><% } %>
<% if (q && q.error) { %><div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i> <%= q.error %></div><% } %>
