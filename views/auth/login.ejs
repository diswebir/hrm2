<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ورود | <%= s.system_name || 'سامانه منابع انسانی' %></title>
  <link rel="stylesheet" href="/vendor/bootstrap.rtl.min.css">
  <link rel="stylesheet" href="/vendor/bootstrap-icons.css">
  <link rel="stylesheet" href="/vendor/fonts-vazirmatn/vazirmatn.css">
  <style>body{font-family:'Vazirmatn',Tahoma;font-size:14px}</style>
</head>
<body>
<div class="login-wrap">
  <div class="login-card">
    <div class="text-center mb-4">
      <div style="width:64px;height:64px;border-radius:18px;background:linear-gradient(135deg,#4f46e5,#6d28d9);display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:30px;">
        <i class="bi bi-people-fill"></i>
      </div>
      <h1 class="mt-3 mb-1" style="font-size:19px;font-weight:800"><%= s.company_name || 'شرکت من' %></h1>
      <p class="text-muted mb-0" style="font-size:13px"><%= s.system_name || 'سامانه جامع منابع انسانی' %></p>
    </div>
    <% if (error) { %><div class="alert alert-danger py-2" style="font-size:13px"><i class="bi bi-exclamation-triangle me-1"></i> <%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success py-2" style="font-size:13px"><i class="bi bi-check-circle me-1"></i> <%= success %></div><% } %>
    <form method="post" action="/login">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="mb-3">
        <label class="form-label">نام کاربری یا ایمیل</label>
        <div class="input-group">
          <span class="input-group-text bg-transparent"><i class="bi bi-person"></i></span>
          <input type="text" class="form-control" name="username" required autofocus>
        </div>
      </div>
      <div class="mb-2">
        <label class="form-label">رمز عبور</label>
        <div class="input-group">
          <span class="input-group-text bg-transparent"><i class="bi bi-lock"></i></span>
          <input type="password" class="form-control" name="password" required>
        </div>
      </div>
      <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="/forgot" style="font-size:12.5px">فراموشی رمز عبور؟</a>
      </div>
      <button class="btn btn-primary w-100 py-2" style="font-weight:700">ورود به سامانه</button>
    </form>
    <p class="text-center mt-4 mb-0" style="font-size:11.5px;color:#9aa3c0">
      <a href="/about" style="color:inherit">درباره سامانه</a> — نسخه <%= s.version || '1.0.0' %>
    </p>
  </div>
</div>
</body>
</html>
