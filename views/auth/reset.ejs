<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>تعیین رمز جدید | سامانه منابع انسانی</title>
  <link rel="stylesheet" href="/vendor/bootstrap.rtl.min.css">
  <link rel="stylesheet" href="/vendor/fonts-vazirmatn/vazirmatn.css">
  <style>body{font-family:'Vazirmatn',Tahoma;font-size:14px}</style>
</head>
<body>
<div class="login-wrap">
  <div class="login-card">
    <h1 class="text-center mb-3" style="font-size:18px;font-weight:800"><i class="bi bi-shield-lock"></i> تعیین رمز جدید</h1>
    <% if (!valid) { %>
      <div class="alert alert-danger">لینک بازیابی نامعتبر یا منقضی شده است.</div>
      <a href="/forgot" class="btn btn-primary w-100">درخواست لینک جدید</a>
    <% } else { %>
      <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
      <form method="post" action="/reset/<%= token %>">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="mb-3"><label class="form-label">رمز عبور جدید</label>
          <input type="password" class="form-control" name="password" required autofocus></div>
        <div class="mb-3"><label class="form-label">تکرار رمز جدید</label>
          <input type="password" class="form-control" name="password2" required></div>
        <button class="btn btn-primary w-100">ثبت رمز جدید</button>
      </form>
    <% } %>
  </div>
</div>
</body>
</html>
