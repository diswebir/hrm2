<%- include('../partials/layout_top', {title: title}) %>
<div class="page-title">
  <div>
    <h1><i class="bi bi-life-preserver"></i> تیکت‌های پشتیبانی</h1>
  </div>
  <a class="btn btn-primary btn-sm" href="/tickets/new"><i class="bi bi-plus-lg me-1"></i> تیکت جدید</a>
</div>
<div class="mb-3">
  <form class="row g-2" method="get" action="/tickets">
    <div class="col-md-3"><select class="form-select form-select-sm" name="status" onchange="this.form.submit()">
      <option value="">همه وضعیت‌ها</option>
      <option value="open" <%= status==='open'?'selected':'' %>>باز</option>
      <option value="answered" <%= status==='answered'?'selected':'' %>>پاسخ داده شده</option>
      <option value="closed" <%= status==='closed'?'selected':'' %>>بسته</option>
    </select></div>
  </form>
</div>
<div class="card">
  <div class="card-body p-0">
    <% if (!rows.length) { %><div class="empty-state"><i class="bi bi-life-preserver"></i>تیکتی وجود ندارد.</div>
    <% } else { %><div class="table-wrap p-3"><table class="table table-hover align-middle" data-sortable>
      <thead><tr><th>کد</th><th>موضوع</th><th>دسته</th><th>اولویت</th><th>ثبت‌کننده</th><th>وضعیت</th><th>آخرین به‌روزرسانی</th><th></th></tr></thead>
      <tbody>
        <% rows.forEach(function(t){ %>
          <tr>
            <td dir="ltr"><b><%= t.code %></b></td>
            <td><a href="/tickets/<%= t.id %>" style="text-decoration:none;font-weight:600"><%= t.subject %></a></td>
            <td><%= categories[t.category] || t.category %></td>
            <td><span class="badge bg-<%= HH.badgeClass(t.priority) %>"><%= U.label(t.priority) %></span></td>
            <td><%= t.username || '—' %></td>
            <td><span class="badge bg-<%= t.status==='open'?'warning text-dark':(t.status==='answered'?'info':'secondary') %>"><%= U.label(t.status) %></span></td>
            <td style="font-size:12px"><%= (t.updated_at || '').slice(0,16).replace('T',' ') %></td>
            <td><a class="btn btn-sm btn-outline-primary btn-icon" href="/tickets/<%= t.id %>"><i class="bi bi-eye"></i></a></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div><% } %>
  </div>
</div>
<%- include('../partials/layout_bottom') %>
