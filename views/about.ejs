<%- include('partials/layout_top', {title: title}) %>
<div class="row justify-content-center mb-4">
  <div class="col-lg-10">
    <div class="card" style="background:linear-gradient(135deg,#171c33,#312e81);color:#fff;border:none;">
      <div class="card-body p-4 p-md-5 text-center">
        <div style="width:74px;height:74px;border-radius:22px;background:linear-gradient(135deg,#4f46e5,#a855f7);display:inline-flex;align-items:center;justify-content:center;font-size:34px;">
          <i class="bi bi-people-fill"></i>
        </div>
        <h1 class="mt-3 mb-2" style="font-weight:900;font-size:24px"><%= s.system_name || 'سامانه جامع منابع انسانی' %></h1>
        <p class="mb-3" style="opacity:.8;font-size:14px">
          نسخه <%= s.version || '1.0.0' %> — ساخته‌شده با Node.js و دیتابیس SQLite | مناسب نصب روی هاست cPanel
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
          <span class="badge bg-light text-dark p-2">✅ <%= U.faNum(total) %> قابلیت آموزش‌داده‌شده</span>
          <span class="badge bg-light text-dark p-2">📅 تقویم شمسی</span>
          <span class="badge bg-light text-dark p-2">🔒 امن (bcrypt + CSRF + نقش‌ها)</span>
          <span class="badge bg-light text-dark p-2">📴 بدون نیاز به اینترنت/CDN</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row justify-content-center">
  <div class="col-lg-10">
    <div class="card mb-4 no-print">
      <div class="card-body">
        <div class="row g-2 align-items-center">
          <div class="col-md-8">
            <div class="input-group">
              <span class="input-group-text bg-transparent"><i class="bi bi-search"></i></span>
              <input type="text" class="form-control" id="featSearch" placeholder="جستجو در قابلیت‌ها... (مثلاً: مرخصی، حقوق، پشتیبان)">
            </div>
          </div>
          <div class="col-md-4 d-flex gap-2 justify-content-md-end">
            <button class="btn btn-outline-secondary btn-sm" id="featExpand"><i class="bi bi-arrows-expand me-1"></i> باز کردن همه</button>
            <button class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer me-1"></i> چاپ راهنما</button>
          </div>
        </div>
        <div class="mt-2" id="catChips">
          <button class="btn btn-sm btn-primary" data-cat="all">همه دسته‌ها</button>
          <% cats.forEach(function(c, i){ %>
            <button class="btn btn-sm btn-outline-secondary" data-cat="<%= i %>"><i class="bi <%= c.icon %> me-1"></i> <%= c.cat %></button>
          <% }) %>
        </div>
      </div>
    </div>

    <% cats.forEach(function(c, ci){ %>
      <div class="feat-cat" data-cat-idx="<%= ci %>">
        <div class="feat-cat-title">
          <i class="bi <%= c.icon %>"></i>
          <%= c.cat %>
          <span class="badge bg-secondary-subtle text-secondary"><%= U.faNum(c.items.length) %> قابلیت</span>
        </div>
        <% c.items.forEach(function(f){ %>
          <div class="feat" data-feat>
            <div class="no"><%= U.faNum(f.no) %></div>
            <div class="flex-grow-1">
              <h6><%= f.t %></h6>
              <div class="desc"><%= f.d %></div>
              <div class="how">
                <b><i class="bi bi-gear me-1"></i> نحوه کار:</b>
                <%= f.how %>
              </div>
              <% if (f.path) { %>
                <span class="path"><i class="bi bi-signpost-2"></i> مسیر: <%= f.path %></span>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% }) %>

    <div class="text-center text-muted2 py-4" style="font-size:12.5px">
      برای دریافت راهنمای فایل‌نصب (cPanel) فایل <code>README.md</code> را در ریشه پروژه ببینید —
      <%= s.company_name %>
    </div>
  </div>
</div>

<script>
(function () {
  const search = document.getElementById('featSearch');
  const chips = document.querySelectorAll('#catChips button');
  const cats = document.querySelectorAll('.feat-cat');
  let activeCat = 'all';
  function apply() {
    const term = (search.value || '').trim();
    cats.forEach(function (cat) {
      if (activeCat !== 'all' && cat.dataset.catIdx !== activeCat) { cat.style.display = 'none'; return; }
      let visible = 0;
      cat.querySelectorAll('[data-feat]').forEach(function (f) {
        const ok = !term || f.textContent.indexOf(term) !== -1;
        f.style.display = ok ? '' : 'none';
        if (ok) visible++;
      });
      cat.style.display = visible ? '' : 'none';
    });
  }
  search.addEventListener('input', apply);
  chips.forEach(function (ch) {
    ch.addEventListener('click', function () {
      chips.forEach(c => { c.classList.remove('btn-primary'); c.classList.add('btn-outline-secondary'); });
      ch.classList.remove('btn-outline-secondary'); ch.classList.add('btn-primary');
      activeCat = ch.dataset.cat;
      apply();
    });
  });
  document.getElementById('featExpand').addEventListener('click', function () {
    document.querySelectorAll('.feat .how').forEach(h => { h.style.whiteSpace = 'normal'; });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
})();
</script>
<%- include('partials/layout_bottom') %>
