<%- include('partials/layout_top', {title: title}) %>
<div class="page-title">
  <div>
    <h1><i class="bi bi-bell"></i> اعلان‌ها</h1>
  </div>
  <form method="post" action="/notifications/read">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-check2-all me-1"></i> خواندن همه</button>
  </form>
</div>
<div class="card">
  <div class="card-body p-0">
    <% if (!rows.length) { %><div class="empty-state"><i class="bi bi-bell-slash"></i>اعلانی ندارید.</div>
    <% } else { %>
      <ul class="list-group list-group-flush">
        <% rows.forEach(function(n){ %>
          <li class="list-group-item <%= n.is_read ? '' : 'bg-primary-subtle' %> d-flex justify-content-between align-items-start gap-3 py-3">
            <div>
              <b style="font-size:13.5px"><i class="bi <%= n.is_read ? 'bi-envelope-open' : 'bi-envelope-fill text-primary' %> me-1"></i> <%= n.title %></b>
              <% if (n.body) { %><div class="text-muted2" style="font-size:12.5px"><%= n.body %></div><% } %>
              <small class="text-muted2"><%= (n.created_at || '').slice(0,16).replace('T',' ') %></small>
            </div>
            <div class="d-flex gap-1">
              <% if (n.link) { %>
                <form method="post" action="/notifications/<%= n.id %>/read">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <input type="hidden" name="link" value="<%= n.link %>">
                  <a class="btn btn-sm btn-outline-primary" href="<%= n.link %>" onclick="this.form.submit()">مشاهده</a>
                </form>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</div>
<%- include('partials/layout_bottom') %>
