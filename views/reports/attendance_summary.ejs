<%- include('../partials/layout_top', {title: title}) %>
<div class="page-title">
  <div>
    <h1><i class="bi bi-clock-history"></i> خلاصه حضور و غیاب</h1>
    <div class="subtitle"><%= U.jDate(from) %> تا <%= U.jDate(to) %></div>
  </div>
  <a class="btn btn-outline-secondary btn-sm" href="/reports/attendance-summary?from=<%= encodeURIComponent(U.jDateEn(from)) %>&to=<%= encodeURIComponent(U.jDateEn(to)) %>&dept=<%= dept %>&csv=1"><i class="bi bi-download me-1"></i> خروجی CSV</a>
</div>
<div class="card mb-3"><div class="card-body">
  <form class="row g-2" method="get" action="/reports/attendance-summary">
    <div class="col-md-3"><label class="form-label">از</label><input type="text" class="form-control form-control-sm jdate" name="from" value="<%= U.jDateEn(from) %>"></div>
    <div class="col-md-3"><label class="form-label">تا</label><input type="text" class="form-control form-control-sm jdate" name="to" value="<%= U.jDateEn(to) %>"></div>
    <div class="col-md-4"><label class="form-label">واحد</label>
      <select class="form-select form-select-sm" name="dept"><option value="">همه</option>
        <% depts.forEach(function(d){ %><option value="<%= d.id %>" <%= dept==String(d.id)?'selected':'' %>><%= d.name %></option><% }) %></select></div>
    <div class="col-md-2 d-flex align-items-end"><button class="btn btn-sm btn-primary w-100">اعمال</button></div>
  </form>
</div></div>
<div class="card">
  <div class="card-body p-0"><div class="table-wrap p-3">
    <table class="table table-hover align-middle" data-sortable>
      <thead><tr><th>کد</th><th>کارمند</th><th>واحد</th><th>حاضر</th><th>غایب</th><th>مرخصی</th><th>مأموریت</th><th>تأخیر (د)</th><th>اضافه‌کاری (س)</th><th>کارکرد (س)</th></tr></thead>
      <tbody>
        <% rows.forEach(function(x){ %>
          <tr>
            <td><%= U.faNum(x.code) %></td>
            <td><b><%= x.first_name %> <%= x.last_name %></b></td>
            <td><%= x.dept_name || '—' %></td>
            <td class="att-p"><%= U.faNum(x.present || 0) %></td>
            <td class="att-a"><%= U.faNum(x.absent || 0) %></td>
            <td class="att-l"><%= U.faNum(x.leaves || 0) %></td>
            <td><%= U.faNum(x.mission || 0) %></td>
            <td><%= U.faNum(x.late || 0) %></td>
            <td><%= U.faNum(Math.round((x.ot || 0)/60)) %></td>
            <td><%= U.faNum(Math.round((x.worked || 0)/60)) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div></div>
</div>
<%- include('../partials/layout_bottom') %>
