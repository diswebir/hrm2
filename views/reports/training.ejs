<%- include('../partials/layout_top', {title: title}) %>
<div class="page-title">
  <div>
    <h1><i class="bi bi-mortarboard"></i> گزارش آموزش</h1>
    <div class="subtitle">جمع هزینه دوره‌ها: <%= U.money(totalCost, currency) %></div>
  </div>
</div>
<div class="card">
  <div class="card-body p-0">
    <% if (!rows.length) { %><div class="empty-state"><i class="bi bi-mortarboard"></i>دوره‌ای ثبت نشده است.</div>
    <% } else { %><div class="table-wrap p-3"><table class="table table-hover align-middle" data-sortable>
      <thead><tr><th>دوره</th><th>برگزارکننده</th><th>بازه</th><th>هزینه</th><th>ثبت‌نام</th><th>تکمیل‌شده</th><th>وضعیت</th></tr></thead>
      <tbody>
        <% rows.forEach(function(t){ %>
          <tr>
            <td><b><%= t.title %></b></td>
            <td><%= t.provider || '—' %></td>
            <td style="font-size:12.5px"><%= U.jDate(t.from_date) %> تا <%= U.jDate(t.to_date) %></td>
            <td><%= U.moneyPlain(t.cost) %></td>
            <td><%= U.faNum(t.enrolled) %> نفر</td>
            <td><%= U.faNum(t.completed) %> نفر</td>
            <td><span class="badge bg-<%= HH.badgeClass(t.status) %>"><%= U.label(t.status) %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div><% } %>
  </div>
</div>
<%- include('../partials/layout_bottom') %>
