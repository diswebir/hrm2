<%- include('../partials/layout_top', {title: title}) %>
<div class="page-title">
  <div>
    <h1><i class="bi bi-exclamation-triangle"></i> موارد در حال انقضا</h1>
    <div class="subtitle"><%= U.faNum(within) %> روز آینده</div>
  </div>
  <div class="d-flex gap-2">
    <form class="d-flex gap-2" method="get" action="/reports/expiring">
      <select class="form-select form-select-sm" name="within" onchange="this.form.submit()">
        <option value="30" <%= within===30?'selected':'' %>>۳۰ روز</option>
        <option value="60" <%= within===60?'selected':'' %>>۶۰ روز</option>
        <option value="90" <%= within===90?'selected':'' %>>۹۰ روز</option>
      </select>
    </form>
    <a class="btn btn-outline-secondary btn-sm" href="/reports/expiring?within=<%= within %>&csv=1"><i class="bi bi-download me-1"></i> خروجی CSV</a>
  </div>
</div>
<div class="row g-3">
  <div class="col-lg-4"><div class="card h-100">
    <div class="card-header"><i class="bi bi-file-earmark-text"></i> قراردادها (<%= U.faNum(contracts.length) %>)</div>
    <div class="card-body p-0"><ul class="list-group list-group-flush">
      <% if (!contracts.length) { %><li class="list-group-item text-muted2" style="font-size:13px">موردی نیست ✓</li><% } %>
      <% contracts.forEach(function(c){ %>
        <li class="list-group-item bg-transparent d-flex justify-content-between" style="font-size:13px">
          <span><%= c.first_name %> <%= c.last_name %><br><small class="text-muted2"><%= c.title %></small></span>
          <span class="text-nowrap text-warning"><%= U.jDate(c.end_date) %><br><small><%= U.faNum(U.daysBetween(today, c.end_date)) %> روز</small></span>
        </li>
      <% }) %>
    </ul></div></div></div>
  <div class="col-lg-4"><div class="card h-100">
    <div class="card-header"><i class="bi bi-briefcase"></i> پایان همکاری ثبت‌شده کارکنان (<%= U.faNum(empContracts.length) %>)</div>
    <div class="card-body p-0"><ul class="list-group list-group-flush">
      <% if (!empContracts.length) { %><li class="list-group-item text-muted2" style="font-size:13px">موردی نیست ✓</li><% } %>
      <% empContracts.forEach(function(e){ %>
        <li class="list-group-item bg-transparent d-flex justify-content-between" style="font-size:13px">
          <span><%= e.first_name %> <%= e.last_name %></span>
          <span class="text-nowrap text-warning"><%= U.jDate(e.contract_end) %><br><small><%= U.faNum(U.daysBetween(today, e.contract_end)) %> روز</small></span>
        </li>
      <% }) %>
    </ul></div></div></div>
  <div class="col-lg-4"><div class="card h-100">
    <div class="card-header"><i class="bi bi-folder2"></i> مدارک (<%= U.faNum(docs.length) %>)</div>
    <div class="card-body p-0"><ul class="list-group list-group-flush">
      <% if (!docs.length) { %><li class="list-group-item text-muted2" style="font-size:13px">موردی نیست ✓</li><% } %>
      <% docs.forEach(function(d){ %>
        <li class="list-group-item bg-transparent d-flex justify-content-between" style="font-size:13px">
          <span><%= d.first_name %> <%= d.last_name %><br><small class="text-muted2"><%= d.title %></small></span>
          <span class="text-nowrap text-danger"><%= U.jDate(d.expiry_date) %><br><small><%= U.faNum(U.daysBetween(today, d.expiry_date)) %> روز</small></span>
        </li>
      <% }) %>
    </ul></div></div></div>
</div>
<%- include('../partials/layout_bottom') %>
