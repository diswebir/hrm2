<%- include('../partials/layout_top', {title: title}) %>
<div class="page-title">
  <div>
    <h1><i class="bi bi-graph-up-arrow"></i> گزارش عملکرد کارکنان</h1>
    <div class="subtitle">میانگین ارزیابی‌ها و پیشرفت اهداف</div>
  </div>
</div>
<div class="card">
  <div class="card-body p-0">
    <% if (!rows.length) { %><div class="empty-state"><i class="bi bi-graph-up-arrow"></i>داده‌ای وجود ندارد — ابتدا هدف یا ارزیابی ثبت کنید.</div>
    <% } else { %><div class="table-wrap p-3"><table class="table table-hover align-middle" data-sortable>
      <thead><tr><th>کارمند</th><th>میانگین ارزیابی (از ۵)</th><th>تعداد اهداف</th><th>اهداف تکمیل‌شده</th><th style="width:30%">میانگین پیشرفت</th></tr></thead>
      <tbody>
        <% rows.forEach(function(x){ %>
          <tr>
            <td><b><%= x.first_name %> <%= x.last_name %></b><br><small class="text-muted2"><%= U.faNum(x.code) %></small></td>
            <td><% if (x.avgScore != null) { %><span class="badge <%= x.avgScore >= 4 ? 'bg-success' : (x.avgScore >= 3 ? 'bg-warning text-dark' : 'bg-danger') %>"><%= U.faNum(x.avgScore) %></span><% } else { %>—<% } %></td>
            <td><%= U.faNum(x.goals.total || 0) %></td>
            <td><%= U.faNum(x.goals.done || 0) %></td>
            <td><div class="progress" style="height:8px"><div class="progress-bar" style="width:<%= Math.round(x.goals.avg_progress || 0) %>%"></div></div>
              <small><%= U.faNum(Math.round(x.goals.avg_progress || 0)) %>٪</small></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div><% } %>
  </div>
</div>
<%- include('../partials/layout_bottom') %>
