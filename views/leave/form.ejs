<%- include('../partials/layout_top', {title: title}) %>
<div class="page-title"><h1><i class="bi bi-calendar2-plus"></i> <%= title %></h1></div>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-body">
        <form method="post" action="/leave/new" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="row g-3">
            <% if (isHr) { %>
              <div class="col-md-6"><label class="form-label req">کارمند</label>
                <select class="form-select" name="employee_id" required>
                  <option value="">— انتخاب کنید —</option>
                  <% emps.forEach(function(e){ %><option value="<%= e.id %>" <%= empId===e.id?'selected':'' %>><%= e.first_name %> <%= e.last_name %></option><% }) %>
                </select></div>
            <% } %>
            <div class="col-md-<%= isHr ? 6 : 12 %>"><label class="form-label req">نوع مرخصی</label>
              <select class="form-select" name="leave_type_id" id="leaveType" required>
                <option value="">— انتخاب کنید —</option>
                <% types.forEach(function(t){ %><option value="<%= t.id %>" data-need-doc="<%= t.requires_doc %>" data-quota="<%= t.annual_quota %>"><%= t.name %> (سقف <%= U.faNum(t.annual_quota) %> روز<%= t.is_paid ? '' : ' — بدون حقوق' %>)</option><% }) %>
              </select></div>
            <div class="col-md-6"><label class="form-label req">از تاریخ</label>
              <input type="text" class="form-control jdate" name="from_date" required value="<%= old && old.from_date ? old.from_date : '' %>"></div>
            <div class="col-md-6"><label class="form-label req">تا تاریخ</label>
              <input type="text" class="form-control jdate" name="to_date" required value="<%= old && old.to_date ? old.to_date : '' %>"></div>
            <div class="col-12"><label class="form-label">دلیل</label>
              <textarea class="form-control" name="reason" rows="3"><%= old ? old.reason : '' %></textarea></div>
            <div class="col-12" id="docWrap" style="display:none">
              <label class="form-label req">پیوست مدرک (الزامی برای این نوع مرخصی)</label>
              <input type="file" class="form-control" name="file">
            </div>
          </div>
          <div class="d-flex gap-2 mt-4 pt-3 border-top">
            <button class="btn btn-primary px-4" style="font-weight:700">ثبت درخواست</button>
            <a class="btn btn-outline-secondary" href="/leave<%= !isHr ? '?mine=1' : '' %>">انصراف</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
  const lt = document.getElementById('leaveType');
  const docWrap = document.getElementById('docWrap');
  lt.addEventListener('change', function () {
    const opt = lt.options[lt.selectedIndex];
    docWrap.style.display = opt && opt.dataset.needDoc === '1' ? '' : 'none';
  });
</script>
<%- include('../partials/layout_bottom') %>
